# Opcional em desenvolvimento: o servidor funciona sem este arquivo.
NODE_ENV=development
PORT=3000
# Exemplo público, apenas para desenvolvimento. Nunca utilizar em produção.
JWT_SECRET=around-development-example-only
# Desenvolvimento usa sempre arounddb, isolado do banco de testes.
MONGO_URI=mongodb://127.0.0.1:27017/arounddb

# Para os testes, configure NODE_ENV=test, JWT_SECRET e exatamente:
# MONGO_URI=mongodb://127.0.0.1:27017/around_test
# Em produção: NODE_ENV=production, JWT_SECRET pseudoaleatório privado
# e MONGO_URI válido com banco explícito diferente de aroundb/arounddb/around_test.

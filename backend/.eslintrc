{
  "extends": "airbnb-base",
  "env": {
    "node": true,
    "jest": true,
    "es2021": true,
  },
  "rules": {
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["_id"],
      },
    ],
    "no-console": "off",
  },

  "overrides": [
    {
      "files": ["tests/**/*.test.js"],
      "rules": {
        "global-require": "off",
        "no-await-in-loop": "off",
        "no-restricted-syntax": "off",
      },
    },
  ],
}
